classDiagram
direction LR

class App {
  +Settings settings
  +Database db
  +RuntimeConfig runtime
  +SentimentModel model
  +Processor processor
  +MessageBus bus
  +dict collectors
  +start() None
  +stop() None
  +publish(raw) None
  +sync_youtube(channel_id, force) int
  +public_status() dict
}

class Database {
  +Path path
  +query(sql, params) list
  +execute(sql, params) int
  +insert_mentions(rows) int
  +existing_ids(ids) set
  +get_setting(key) Any
}

class RuntimeConfig {
  +dict value
  +get() dict
  +update(patch) dict
  +reset() dict
}

class Collector {
  <<interface>>
  +configured() bool
  +status() dict
  +poll(brand, keywords) list
}

class BaseCollector {
  +Settings settings
  +float last_poll
  +int last_count
  +str last_error
  +int total
}

class RssCollector
class RedditCollector
class TwitterCollector
class AppStoreCollector
class YouTubeChannelCollector
class InstagramCollector

class YouTubeService {
  +Database db
  +bool configured
  +resolve(query) dict
  +save_channel(row) dict
  +list_channels() list
  +sync_channel(channel, force) list
  +sync_all(force) list
}

class InstagramService {
  +TokenCipher cipher
  +authorization_url() str
  +complete_login(code) dict
  +sync_account(account, force) list
}

class TokenCipher {
  +encrypt(value) str
  +decrypt(value) str
}

class MessageBus {
  <<interface>>
  +publish(message) None
  +batches(max_batch, max_wait) AsyncIterator
  +depth() int
}
class MemoryBus {
  +Queue queue
  +int published
}
class KafkaBus {
  +str bootstrap_servers
  +str topic
}

class Processor {
  +SentimentModel model
  +AspectExtractor aspects
  +PipelineMetrics metrics
  +analyze(raws) list
  +process_batch(messages) list
  +run(bus) None
}

class TextPreprocessor {
  <<utility>>
  +preprocess(text) PreparedText
  +detect_spam(original, clean) str
  +detect_language(text) str
}

class PreparedText {
  +str clean
  +str model_text
  +list tokens
  +list lemmas
  +str language
  +bool is_spam
  +str spam_reason
}

class SentimentModel {
  +str model_name
  +int batch_size
  +float avg_inference_ms
  +load() None
  +predict(texts) list
}

class AspectExtractor {
  +dict compiled
  +find(text) list
  +extract_clauses(text) dict
  +analyze_batch(texts, overall, model) list
}

class AnalyticsService {
  +dict latest
  +dict forecast_data
  +overview(hours) dict
  +trends(hours, bucket) dict
  +anomalies(hours) dict
  +compute_snapshot() dict
  +refresh_forecast() dict
}

class AnomalyDetector {
  <<utility>>
  +bucketize(df, minutes) DataFrame
  +detect_anomalies(buckets, contamination) DataFrame
  +summarise_anomalies(data) list
}

class Forecaster {
  <<utility>>
  +forecast(series, horizon) dict
}

class RiskScorer {
  <<utility>>
  +compute_risk(anomalies, forecast, aspects) dict
}

class AlertEngine {
  +raise_alert(severity, type, title) dict
  +evaluate(snapshot, forecast) list
  +check_mentions(mentions) None
  +set_status(alert_id, status) bool
}

class Notifier {
  +channels_status() dict
  +send(alert, prefs, brand) dict
}

class Hub {
  +int client_count
  +connect(ws) None
  +broadcast(event_type, data) None
}

class PipelineMetrics {
  +int processed
  +int stored
  +record_batch(size, stored, seconds) None
  +snapshot(queue_depth, model) dict
}

class Mention {
  +str id
  +str source
  +str author
  +str text
  +str language
  +str sentiment
  +float confidence
  +float score
  +list aspects
  +bool is_spam
  +int engagement
  +str parent_id
}

class Alert {
  +int id
  +str severity
  +str type
  +str title
  +str status
}

class YouTubeChannel {
  +str channel_id
  +str handle
  +int subscriber_count
  +int video_count
}

class YouTubeVideo {
  +str id
  +str title
  +int view_count
  +int comment_count
  +int synced_comments
}

App *-- Database
App *-- RuntimeConfig
App *-- Processor
App *-- AnalyticsService
App *-- AlertEngine
App *-- Hub
App *-- PipelineMetrics
App *-- MessageBus
App *-- YouTubeService
App *-- InstagramService
App o-- Collector

Collector <|.. BaseCollector
BaseCollector <|-- RssCollector
BaseCollector <|-- RedditCollector
BaseCollector <|-- TwitterCollector
BaseCollector <|-- AppStoreCollector
Collector <|.. YouTubeChannelCollector
Collector <|.. InstagramCollector

YouTubeChannelCollector --> YouTubeService
InstagramCollector --> InstagramService
InstagramService *-- TokenCipher

MessageBus <|.. MemoryBus
MessageBus <|.. KafkaBus

Processor --> SentimentModel
Processor --> AspectExtractor
Processor --> TextPreprocessor
Processor --> Database
TextPreprocessor ..> PreparedText : creates
AspectExtractor --> SentimentModel
Processor ..> Mention : creates

AnalyticsService --> AnomalyDetector
AnalyticsService --> Forecaster
AnalyticsService --> RiskScorer
AnalyticsService --> Database

AlertEngine --> Notifier
AlertEngine --> Hub
AlertEngine ..> Alert : creates

YouTubeService --> YouTubeChannel
YouTubeChannel "1" *-- "0..n" YouTubeVideo
YouTubeVideo "1" o-- "0..n" Mention
