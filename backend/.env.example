# Copy this file to backend/.env and fill in what you need.
# Everything is optional - with no keys the live simulator + Google News RSS work.

# ---- Brand (can also be changed from the Settings page) ----
BRAND_NAME=Saffron Cafe
BRAND_KEYWORDS=Saffron Cafe,SaffronCafe,saffron_cafe

# ---- Streaming: "memory" (default) or "kafka" ----
BUS_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Simulator ----
ENABLE_SIMULATOR=true
SIMULATOR_RATE_PER_MIN=8
# days of history generated on first start (0 = none)
SEED_HISTORY_DAYS=3

# ---- Reddit (https://www.reddit.com/prefs/apps -> "script" app) ----
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- News / RSS ----
ENABLE_RSS=false
# extra feeds, comma separated
RSS_FEEDS=

# ---- Twitter / X API v2 (paid tier needed for search) ----
ENABLE_TWITTER=false
TWITTER_BEARER_TOKEN=

# ---- Public Instagram pages of ANY brand (no Instagram account needed) ----
# Free token: console.apify.com -> Settings -> API & Integrations -> Personal API tokens
APIFY_TOKEN=
INSTAGRAM_PAGES_POSTS=6
INSTAGRAM_PAGES_COMMENTS_PER_POST=40
INSTAGRAM_PAGES_POLL_SECONDS=900

# ---- Instagram (Instagram API with Instagram Login) ----
# Create an app at developers.facebook.com -> Instagram -> "API setup with Instagram login".
# The Instagram page in the dashboard shows the exact redirect URI to paste there.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Public URL of this backend. Meta requires https, so while developing use a tunnel
# (e.g. cloudflared tunnel --url http://127.0.0.1:8000) and put its https URL here.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional key used to encrypt stored Instagram tokens (auto-generated if empty)
SECRET_KEY=

POLL_INTERVAL_SECONDS=180

# ---- Email alerts (Gmail: smtp.gmail.com + an App Password) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---- Slack / Teams incoming webhooks ----
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ---- SMS via Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=
